# Runtime/storage
APP_DATA_DIR=
DATABASE_PATH=
HOST=127.0.0.1
PORT=8000
APP_BASE_URL=
APP_AUTH_ENABLED=false
APP_USERNAME=
APP_PASSWORD=

# AI/document generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DAILY_AI_BUDGET=2.00
MAX_JOBS_PER_RUN=100
MIN_MATCH_SCORE=75
APPLICATION_MODE=PREPARE
TIMEZONE=Africa/Johannesburg

# Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREDENTIALS_FILE=
GOOGLE_REDIRECT_URI=
GOOGLE_GMAIL_ENABLED=true
GOOGLE_DRIVE_ENABLED=true
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_GMAIL_AUTO_SEND=false

# Optional SMTP fallback
EMAIL_AUTO_SEND=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
