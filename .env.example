# Runtime
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000
TIMEZONE=Africa/Johannesburg

# Durable data. SQLite is local/test only; production uses Neon/Postgres.
DATABASE_PATH=data/job_agent.db
DATABASE_URL=
STORAGE_PROVIDER=local

# Private workspace authentication
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
ADMIN_USERNAME=tumelo
# Generate an Argon2id hash; never commit the raw password.
ADMIN_PASSWORD_HASH=

# Scheduled search
CRON_SECRET=
MAX_JOBS_PER_RUN=120
RUN_TIME_BUDGET_SECONDS=240
SOURCE_TIME_BUDGET_SECONDS=40
RUN_STALE_AFTER_SECONDS=900

# Optional AI-assisted semantic analysis. The app has a deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DAILY_AI_BUDGET=2.00

# Google OAuth / Gmail application delivery
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave blank in hosted environments to derive <APP_BASE_URL>/api/google/callback.
GOOGLE_REDIRECT_URI=
GOOGLE_GMAIL_ENABLED=true
GOOGLE_DRIVE_ENABLED=true
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_GMAIL_AUTO_SEND=true

# Optional S3-compatible storage alternative to STORAGE_PROVIDER=database
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
