{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{frontend/**,config/**}"
    }
  },
  "rewrites": [
    {"source": "/(.*)", "destination": "/api/index.py"}
  ],
  "crons": [
    {"path": "/api/cron/search", "schedule": "0 5 * * *"}
  ]
}
